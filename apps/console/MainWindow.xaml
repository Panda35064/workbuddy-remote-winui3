<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkBuddyRemote.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkBuddyRemote.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WorkBuddy Remote 控制台">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（可拖动），沿用旧启动器图标 -->
        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,16,0"
            ColumnSpacing="10"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Source="ms-appx:///Assets/app.png"
                Width="18"
                Height="18"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                Text="WorkBuddy Remote 控制台"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- 官方 NavigationView 作为应用外壳 -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="216"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnNavItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="overview" Icon="Home" />
                <NavigationViewItem Content="运行日志" Tag="logs" Icon="Document" />
                <NavigationViewItem Content="关于" Tag="about" Icon="Help" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="打开网页" Tag="open-url" Icon="Globe" />
            </NavigationView.FooterMenuItems>

            <Grid Padding="24,12,24,20">
                <!-- ============================ 概览 ============================ -->
                <ScrollViewer
                    x:Name="OverviewPanel"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="12" Padding="0,0,0,24">

                        <StackPanel Spacing="2">
                            <TextBlock Text="概览" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                Text="桥接服务状态与常用操作"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <InfoBar
                            x:Name="StatusBar"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Title="检测中"
                            Message="正在检查桥接状态…" />
                        <InfoBar
                            x:Name="UpdateBar"
                            IsOpen="False"
                            IsClosable="True"
                            Severity="Informational"
                            Title="发现新版本"
                            Message="—">
                            <InfoBar.ActionButton>
                                <Button x:Name="UpdateButton" Click="OnDownloadUpdateClick" Content="下载" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <ProgressBar
                            x:Name="BusyBar"
                            IsIndeterminate="True"
                            Visibility="Collapsed"
                            Margin="0,-4,0,0" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            Glyph="&#xE774;"
                                            FontSize="14"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="访问" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="AddressText"
                                            IsReadOnly="True"
                                            Text="—"
                                            TextWrapping="NoWrap"
                                            BorderThickness="0"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            FontSize="12" />
                                        <Button
                                            x:Name="CopyAddressButton"
                                            Grid.Column="1"
                                            Click="OnCopyAddressClick"
                                            ToolTipService.ToolTip="复制访问地址"
                                            Padding="8">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="监听范围"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                x:Name="ListenText"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="—" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="桥接端口"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                x:Name="PortText"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="—" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            Glyph="&#xE950;"
                                            FontSize="14"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="WorkBuddy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="版本"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                x:Name="VersionText"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="—" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="调试端口"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                x:Name="CdpText"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="—" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="WorkDaddy"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                x:Name="WorkDaddyText"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="—" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="构建"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                x:Name="BuildText"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="—" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="操作" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="StartButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OnStartClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="启动" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RestartBridgeButton" Click="OnRestartBridgeClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                            <TextBlock Text="重启桥接" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StopButton" Click="OnStopClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                            <TextBlock Text="停止" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OpenButton" Click="OnOpenClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                                            <TextBlock Text="打开页面" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="RestartAppButton" Click="OnRestartWorkBuddyClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE777;" FontSize="14" />
                                            <TextBlock Text="重启 WorkBuddy" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LogFolderButton" Click="OnOpenLogsClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            <TextBlock Text="打开日志目录" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DiagnosticsButton" Click="OnExportDiagnosticsClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                            <TextBlock Text="导出诊断包" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="最近日志" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <HyperlinkButton
                                        Content="查看全部"
                                        HorizontalAlignment="Right"
                                        Click="OnShowLogsClick" />
                                </Grid>
                                <ScrollViewer
                                    Grid.Row="1"
                                    Height="118"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Auto">
                                    <TextBlock
                                        x:Name="RecentLogText"
                                        Style="{StaticResource MonoTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="—"
                                        IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================ 日志 ============================ -->
                <Grid x:Name="LogsPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="运行日志" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="LogPathText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                Text="—" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Bottom">
                            <Button Click="OnOpenLogsClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="打开目录" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnCopyLogClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="复制" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnClearLogClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="清空" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="0">
                        <TextBox
                            x:Name="LogBox"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="12"
                            VerticalAlignment="Stretch"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>

                <!-- ============================ 设置 ============================ -->
                <ScrollViewer
                    x:Name="SettingsPanel"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="2" Padding="0,0,0,32" MaxWidth="920" HorizontalAlignment="Stretch">

                        <StackPanel Spacing="2" Margin="0,0,0,8">
                            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                Text="保存后重新启动桥接才会生效"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="访问" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                        <local:SettingsCard
                            Glyph="&#xE774;"
                            Header="访问范围"
                            Description="局域网或端口映射访问时，必须设置访问密码">
                            <local:SettingsCard.CardContent>
                                <ComboBox
                                    x:Name="ScopeBox"
                                    Width="220"
                                    SelectionChanged="OnScopeChanged">
                                    <ComboBoxItem Content="仅本机" />
                                    <ComboBoxItem Content="局域网 / 端口映射" />
                                </ComboBox>
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard
                            Glyph="&#xE8AB;"
                            Header="桥接端口"
                            Description="网页控制台与 API 使用的端口">
                            <local:SettingsCard.CardContent>
                                <NumberBox
                                    x:Name="BridgePortBox"
                                    Width="160"
                                    Minimum="1"
                                    Maximum="65535"
                                    SpinButtonPlacementMode="Compact"
                                    SmallChange="1" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard
                            Glyph="&#xE7F4;"
                            Header="CDP 端口"
                            Description="WorkBuddy 远程调试端口，需与桥接端口不同">
                            <local:SettingsCard.CardContent>
                                <NumberBox
                                    x:Name="CdpPortBox"
                                    Width="160"
                                    Minimum="1"
                                    Maximum="65535"
                                    SpinButtonPlacementMode="Compact"
                                    SmallChange="1" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard
                            Glyph="&#xE72E;"
                            Header="访问密码"
                            Description="留空表示不修改；仅本机访问时不需要密码；至少 4 位">
                            <local:SettingsCard.CardContent>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PasswordBox
                                        x:Name="PasswordBox1"
                                        Width="180"
                                        PlaceholderText="新密码" />
                                    <PasswordBox
                                        x:Name="PasswordBox2"
                                        Width="180"
                                        PlaceholderText="确认密码" />
                                    <Button
                                        x:Name="ClearPasswordButton"
                                        Content="清除"
                                        Click="OnClearPasswordClick"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <TextBlock Text="路径" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                        <local:SettingsCard
                            Glyph="&#xE756;"
                            Header="WorkBuddy 主程序"
                            Description="留空时自动从安装位置查找">
                            <local:SettingsCard.CardContent>
                                <TextBox x:Name="ExePathBox" Width="380" PlaceholderText="自动查找" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard
                            Glyph="&#xE8B7;"
                            Header="用户数据目录"
                            Description="留空时使用 WorkBuddy 默认目录">
                            <local:SettingsCard.CardContent>
                                <TextBox x:Name="UserDataBox" Width="380" PlaceholderText="默认" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <TextBlock Text="功能" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                        <local:SettingsCard Glyph="&#xE7B3;" Header="启动后隐藏 WorkBuddy 窗口" Description="桥接就绪后把桌面窗口收起来">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="HideWindowCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard Glyph="&#xE71A;" Header="启动前结束后台 WorkBuddy 进程" Description="避免旧实例占用单实例锁或调试端口">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="KillBeforeStartCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard Glyph="&#xE777;" Header="静默启动时自动重启 WorkBuddy" Description="开机自启发现没有调试端口时自动重启一次">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="AutoRestartCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard Glyph="&#xE8F8;" Header="同时启动 WorkDaddy" Description="启动 WorkBuddy 时拉起 WorkDaddy 守护进程并共用 CDP 端口">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="StartWorkDaddyCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard Glyph="&#xE7E8;" Header="开机自动启动" Description="登录后静默启动桥接（启动文件夹快捷方式）">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="AutoRunCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard Glyph="&#xE8A7;" Header="关闭窗口时收进托盘" Description="程序继续在后台运行，双击托盘图标可唤回控制台">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="CloseToTrayCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard Glyph="&#xE81C;" Header="退出后保留桥接" Description="关闭控制台不结束桥接进程，下次启动会自动接管">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="KeepBridgeOnExitCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard Glyph="&#xE8B7;" Header="允许文件管理" Description="网页端可浏览服务端目录、上传与新建文件夹">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="FileManagerCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard Glyph="&#xE72C;" Header="允许页面内重启" Description="网页端可触发 WorkBuddy 重启">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="EnableRestartCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <local:SettingsCard Glyph="&#xE72E;" Header="隐藏模型 API Key" Description="转发给网页端的模型配置里打码">
                            <local:SettingsCard.CardContent>
                                <ToggleSwitch x:Name="MaskSecretsCheck" MinWidth="0" />
                            </local:SettingsCard.CardContent>
                        </local:SettingsCard>

                        <InfoBar
                            x:Name="SettingsInfoBar"
                            IsOpen="False"
                            IsClosable="True"
                            Severity="Success"
                            Margin="0,12,0,0" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnSaveSettingsClick"
                                Content="保存设置" />
                            <Button Click="OnReloadSettingsClick" Content="重新载入" />
                            <HyperlinkButton Click="OnOpenConfigClick" Content="打开配置文件" />
                        </StackPanel>

                        <TextBlock
                            x:Name="ConfigHint"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="2,8,0,0"
                            Text="—" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================ 关于 ============================ -->
                <ScrollViewer
                    x:Name="AboutPanel"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="12" Padding="0,0,0,32" MaxWidth="820" HorizontalAlignment="Left">
                        <StackPanel Spacing="2" Margin="0,0,0,4">
                            <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                Text="把本机 WorkBuddy 变成可远程访问的网页工作台"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Source="ms-appx:///Assets/app.png"
                                    Width="64"
                                    Height="64"
                                    VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="WorkBuddy Remote" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="AboutVersionText"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="—" />
                                    <TextBlock
                                        Text="非官方项目 · 与 WorkBuddy 官方团队无关"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock
                                        Text="通过 CDP 桥接把 WorkBuddy 的界面映射到浏览器：支持远程文件浏览、设置、产物查看，兼容 WorkDaddy 插件。"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="环境" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="适配 WorkBuddy" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AboutAdaptedText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="—" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="本机 WorkBuddy" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AboutInstalledText" Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                                    <TextBlock Grid.Row="2" Text="项目目录" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AboutProjectText" Grid.Row="2" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Text="—" />
                                    <TextBlock Grid.Row="3" Text="配置文件" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AboutConfigText" Grid.Row="3" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Text="—" />
                                    <TextBlock Grid.Row="4" Text="日志目录" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AboutLogsText" Grid.Row="4" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Text="—" />
                                    <TextBlock Grid.Row="5" Text="端口" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AboutPortsText" Grid.Row="5" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="项目" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Text="GitHub"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap"
                                        Text="https://github.com/Panda35064/workbuddy-remote-winui3" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="作者"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        IsTextSelectionEnabled="True"
                                        Text="Panda35064" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="上游项目"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap"
                                        Text="vergess3/workbuddy-remote（MIT）" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="OnOpenRepoClick" Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                            <TextBlock Text="打开 GitHub 仓库" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnOpenIssuesClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE734;" FontSize="14" />
                                            <TextBlock Text="去 Star / 反馈问题" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnOpenProjectClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="打开项目目录" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenConfigClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    <TextBlock Text="打开配置文件" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenLogsClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="打开日志目录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
